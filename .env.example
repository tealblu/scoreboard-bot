TOKEN=YOUR_BOT_TOKEN_HERE
PREFIX=YOUR_BOT_PREFIX_HERE

# Timezone the bot treats as its local day: scores are stored under the
# YYYY-MM-DD date of THIS timezone, and the daily reminder time is
# interpreted in it. Use an IANA timezone name, e.g. America/New_York,
# Europe/London, Asia/Tokyo. Defaults to UTC when unset.
TIMEZONE=UTC